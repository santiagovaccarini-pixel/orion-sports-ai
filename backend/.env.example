ORION_HOST=127.0.0.1
ORION_PORT=8765

# Model provider: ollama | cloudflare
ORION_MODEL_PROVIDER=ollama

# Local provider
ORION_OLLAMA_URL=http://127.0.0.1:11434
ORION_QUICK_MODEL=qwen3:4b-instruct
ORION_DEEP_MODEL=qwen3:8b

# Cloudflare Workers AI provider. Never commit real credentials.
ORION_CLOUDFLARE_ACCOUNT_ID=
ORION_CLOUDFLARE_API_TOKEN=
ORION_CLOUDFLARE_QUICK_MODEL=@cf/zai-org/glm-4.7-flash
ORION_CLOUDFLARE_DEEP_MODEL=@cf/nvidia/nemotron-3-120b-a12b

ORION_QUICK_CONTEXT=4096
ORION_DEEP_CONTEXT=8192
ORION_QUICK_THREADS=8
ORION_DEEP_THREADS=8
ORION_QUICK_MAX_TOKENS=768
ORION_DEEP_MAX_TOKENS=1536
ORION_QUICK_HISTORY_CHARACTERS=12000
ORION_DEEP_HISTORY_CHARACTERS=30000
ORION_KEEP_ALIVE=10m
ORION_REQUEST_TIMEOUT=300
# Leave empty for local-only use. Set a strong value before remote deployment.
ORION_API_KEY=
ORION_KNOWLEDGE_PATH=.orion-runtime/knowledge/documents.json
ORION_WEB_ENABLED=true
ORION_WEB_MINIMUM_SOURCES=4
ORION_WEB_ALLOWED_DOMAINS=fifa.com,theifab.com,uefa.com,pubmed.ncbi.nlm.nih.gov,ncbi.nlm.nih.gov,who.int,acsm.org,bocajuniors.com.ar,afa.com.ar,ligaprofesional.ar,espn.com.ar,transfermarkt.es,worldfootball.net,fbref.com,soccerway.com,as.com,tycsports.com,elobservador.com.uy,365scores.com
ORION_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
