ORION_HOST=127.0.0.1
ORION_PORT=8765

# Orion canónico: Cloudflare Workers AI + gpt-oss. Ollama queda solo como
# compatibilidad local legacy y requiere configurarlo explícitamente.
ORION_MODEL_PROVIDER=cloudflare

# Compatibilidad local legacy (no es el motor normal de Orion)
ORION_OLLAMA_URL=http://127.0.0.1:11434
ORION_QUICK_MODEL=qwen3:4b-instruct
ORION_DEEP_MODEL=qwen3:8b

# Motor cloud gratuito para el prototipo.
# No guardar valores reales en GitHub: configurarlos como secretos del entorno.
ORION_CLOUDFLARE_ACCOUNT_ID=
ORION_CLOUDFLARE_API_TOKEN=
ORION_CLOUDFLARE_QUICK_MODEL=@cf/openai/gpt-oss-120b
ORION_CLOUDFLARE_DEEP_MODEL=@cf/openai/gpt-oss-120b
# gpt-oss razona dentro del mismo presupuesto de salida. Quick usa esfuerzo bajo;
# Deep usa medio por defecto. El pipeline puede bajar/subir esfuerzo por etapa.
ORION_CLOUDFLARE_QUICK_REASONING_EFFORT=low
ORION_CLOUDFLARE_DEEP_REASONING_EFFORT=medium
ORION_CLOUDFLARE_QUICK_MAX_TOKENS=1536
ORION_CLOUDFLARE_DEEP_MAX_TOKENS=3072

ORION_QUICK_CONTEXT=4096
ORION_DEEP_CONTEXT=8192
ORION_QUICK_THREADS=8
ORION_DEEP_THREADS=8
# Presupuestos exclusivos de compatibilidad Ollama legacy.
ORION_QUICK_MAX_TOKENS=768
ORION_DEEP_MAX_TOKENS=1536
ORION_QUICK_HISTORY_CHARACTERS=12000
ORION_DEEP_HISTORY_CHARACTERS=30000
ORION_KEEP_ALIVE=10m
ORION_REQUEST_TIMEOUT=300

# Set a strong value before remote deployment or local browser access to Orion Cloud.
ORION_API_KEY=
ORION_KNOWLEDGE_PATH=.orion-runtime/knowledge/documents.json

# Investigación web. Con Tavily configurado, la búsqueda primaria es web abierta y
# la relevancia/autoridad se evalúan en la etapa semántica de revisión de evidencia.
# En provider=auto, una búsqueda Tavily vacía/fallida puede caer al fallback HTML.
ORION_WEB_ENABLED=true
ORION_WEB_PROVIDER=auto
ORION_TAVILY_API_KEY=
ORION_WEB_MINIMUM_SOURCES=4
ORION_WEB_ALLOWED_DOMAINS=fifa.com,theifab.com,uefa.com,pubmed.ncbi.nlm.nih.gov,ncbi.nlm.nih.gov,who.int,acsm.org,bocajuniors.com.ar,afa.com.ar,ligaprofesional.ar,espn.com.ar,transfermarkt.es,worldfootball.net,fbref.com,soccerway.com,as.com,tycsports.com,elobservador.com.uy,365scores.com

# Ciclo semántico: comprender -> planificar -> herramientas -> revisar -> responder.
# El modelo decide por significado si necesita web, datos locales, calculadora, gráfico
# o aclaración. Python valida/ejecuta especificaciones estructuradas y no asigna
# significados mediante listas de palabras. El revisor puede pedir hasta tres búsquedas
# distintas; consultas repetidas se bloquean sin consumir otra ronda.
ORION_SEMANTIC_ORCHESTRATION=false
ORION_SEMANTIC_MAX_TOOL_ROUNDS=3
ORION_SEMANTIC_LOCAL_CONTEXT_CHARACTERS=12000

# Caja negra de desarrollo: mantiene solo las últimas trazas en RAM del proceso.
# Registra decisiones estructuradas, fuentes, herramientas, tokens, finish_reason,
# reasoning effort y tiempos; nunca credenciales ni cadena de pensamiento oculta.
# Se pierde automáticamente al reiniciar el servicio.
ORION_DIAGNOSTICS_ENABLED=false

ORION_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
